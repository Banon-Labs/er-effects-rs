<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- TFM is auto-detected from the installed Andre.SoulsFormats.dll so the
         bridge builds against whichever .NET the Smithbox install targets. -->
    <TargetFramework>{{TFM}}</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Andre.Formats">
      <HintPath>{{ANDRE_FORMATS_DLL}}</HintPath>
    </Reference>
    <Reference Include="Andre.SoulsFormats">
      <HintPath>{{ANDRE_SOULSFORMATS_DLL}}</HintPath>
    </Reference>
  </ItemGroup>
</Project>
